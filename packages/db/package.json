{
	"name": "@repo/db",
	"version": "0.0.1",
	"description": "Framework-agnostic Drizzle ORM database package with schema definitions and database client.",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"default": "./dist/schema/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"typesVersions": {
		"*": {
			"schema": [
				"./dist/schema/index.d.ts"
			],
			"client": [
				"./dist/client.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"format": "prettier --check \"src/**/*.ts\"",
		"format:fix": "prettier --write \"src/**/*.ts\"",
		"lint": "eslint --flag unstable_native_nodejs_ts_config \"src/**/*.ts\" --fix",
		"typecheck": "tsc --noEmit",
		"push": "pnpm build && drizzle-kit push",
		"seed:dev": "tsx src/seed-dev.ts",
		"studio": "pnpm build && drizzle-kit studio",
		"generate": "pnpm build && drizzle-kit generate",
		"migrate": "pnpm build && drizzle-kit migrate",
		"seed:formulary": "tsx src/seed-formulary.ts",
		"seed:icd10-cm": "tsx src/seed-icd10-cm.ts",
		"seed:icd10-cm:dry": "tsx src/seed-icd10-cm.ts --dry-run",
		"seed:loinc": "tsx src/seed-loinc.ts",
		"seed:loinc:dry": "tsx src/seed-loinc.ts --dry-run",
		"seed:rxnorm-generics": "tsx src/seed-rxnorm-generics.ts",
		"seed:rxnorm-generics:dry": "tsx src/seed-rxnorm-generics.ts --dry-run"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"fflate": "catalog:",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/prettier-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"dotenv": "catalog:",
		"drizzle-kit": "1.0.0-beta.20",
		"eslint": "catalog:",
		"prettier": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"prettier": "@repo/prettier-config"
}
