# ==========================================================
# BACKEND API ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Database
DATABASE_URL="postgres://postgres:password@localhost:5432/turbo-template"

# Authentication (Better Auth)
BETTER_AUTH_SECRET=default-secret-for-testing-change-in-production
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000
BETTER_AUTH_COOKIE_DOMAIN=localhost

# OAuth Providers (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PhilHealth Integration
PHILHEALTH_MODE=mock
PHILHEALTH_CEWS_BASE_URL=https://example-philhealth-api.local
PHILHEALTH_CEWS_API_KEY=your-philhealth-api-key
PHILHEALTH_MOCK_ELIGIBILITY_STATUS=eligible
PHILHEALTH_MOCK_ELIGIBLE=true
PHILHEALTH_MOCK_MEMBER_NAME=Mock PhilHealth Member
PHILHEALTH_MOCK_MEMBER_TYPE=sponsored
PHILHEALTH_MOCK_PATIENT_RELATION=member
PHILHEALTH_MOCK_EFFECTIVITY_DATE=2025-01-01
PHILHEALTH_MOCK_EXPIRY_DATE=2026-12-31
PHILHEALTH_MOCK_REMAINING_BENEFIT=45000
PHILHEALTH_MOCK_ERROR_MESSAGE=Mock PhilHealth error response.
