# ==========================================================
# BACKEND API ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_BUCKET_NAME="hims"

# Authentication (Better Auth)
BETTER_AUTH_SECRET=default-secret-for-testing-change-in-production
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000
BETTER_AUTH_COOKIE_DOMAIN=localhost

# OAuth Providers (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PhilHealth Integration
PHILHEALTH_MODE=mock
PHILHEALTH_CEWS_BASE_URL=https://example-philhealth-api.local
PHILHEALTH_CEWS_API_KEY=your-philhealth-api-key
PHILHEALTH_MOCK_ELIGIBILITY_STATUS=eligible
PHILHEALTH_MOCK_ELIGIBLE=true
PHILHEALTH_MOCK_MEMBER_NAME=Mock PhilHealth Member
PHILHEALTH_MOCK_MEMBER_TYPE=sponsored
PHILHEALTH_MOCK_PATIENT_RELATION=member
PHILHEALTH_MOCK_EFFECTIVITY_DATE=2025-01-01
PHILHEALTH_MOCK_EXPIRY_DATE=2026-12-31
PHILHEALTH_MOCK_REMAINING_BENEFIT=45000
PHILHEALTH_MOCK_ERROR_MESSAGE=Mock PhilHealth error response.

# LiveKit Video Conferencing
# Set LIVEKIT_MODE=real and fill credentials when LiveKit server is ready
LIVEKIT_MODE=mock
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# ElevenLabs Speech-to-Text
# Set ELEVENLABS_API_KEY to enable voice-to-text dictation in the note editor
ELEVENLABS_API_KEY=

# File Storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=./storage
FILE_STORAGE_BASE_URL=/storage

# AWS S3 File Storage
# Set FILE_STORAGE_TYPE=s3 and fill these values to store artifacts in S3
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# NHDR (National Health Data Repository) Submission
NHDR_MODE=mock
# Uncomment and set real values only when NHDR_MODE=real
# NHDR_BASE_URL=https://example-nhdr-api.local
# NHDR_API_KEY=your-nhdr-api-key

# LCR API Submission
LCR_API_ENABLED=false
LCR_API_BASE_URL=
LCR_API_KEY=
LCR_API_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────────────────────────
# Observability (migrated from turbo-template; all OFF by default)
# ──────────────────────────────────────────────────────────────────────────────

# Structured log level for the pino logger.
LOG_LEVEL=info               # fatal | error | warn | info | debug | trace

# Error monitoring (Sentry; see docs/sentry.md)
# Off by default. Reporting starts only when BOTH SENTRY_ENABLED=true AND a
# valid SENTRY_DSN are set. With either missing the SDK is never initialised.
# SENTRY_ENABLED=true
# SENTRY_DSN=https://<publicKey>@<org>.ingest.sentry.io/<projectId>
# Groups events in the Sentry UI. Falls back to NODE_ENV when unset.
# SENTRY_ENVIRONMENT=staging
# Performance tracing sample rate, 0..1. Defaults to 0 (errors only).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# IMAGE_TAG is set by the deploy workflow and reported as the Sentry release.

# Product analytics / feature flags (PostHog; see docs/posthog.md)
# Off by default. Nothing is constructed unless BOTH POSTHOG_ENABLED=true AND a
# POSTHOG_TOKEN are set.
# POSTHOG_ENABLED=true
# POSTHOG_TOKEN=phc_<project-token>
# POSTHOG_HOST=https://us.i.posthog.com
# Optional project secret key (phs_...): evaluates flags locally. A secret.
# POSTHOG_FEATURE_FLAGS_SECRET_KEY=phs_<secret-key>

# OpenTelemetry (traces and HTTP metrics over OTLP; see docs/opentelemetry.md)
# Off by default. Export starts only when BOTH OTEL_ENABLED=true AND an
# http(s) OTLP endpoint are set.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=qhealth-emr-api
# Auth for a hosted backend, read by the OpenTelemetry SDK itself. A secret.
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<key>
