# ==========================================================
# WEB APP ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# Database (server-side)
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
# Server-only key (do not prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_BUCKET_NAME="hims"

# Internal API URL (Docker/staging only)
# Used by Server Components to reach the backend over the internal Docker network.
# Leave unset for local development - falls back to NEXT_PUBLIC_API_BASE_URL.
# INTERNAL_API_BASE_URL=http://backend:3000/api

# ──────────────────────────────────────────────────────────────────────────────
# Observability (migrated from turbo-template; all OFF by default)
# ──────────────────────────────────────────────────────────────────────────────

# Sentry — server/edge runtimes (reporting starts only with BOTH flag + DSN)
# SENTRY_ENABLED=true
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# SENTRY_ENVIRONMENT=staging

# Sentry — browser runtime (DSN is a public write-only ingest key)
# NEXT_PUBLIC_SENTRY_ENABLED=true
# NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# Optional; when unset the build projects SENTRY_ENVIRONMENT onto it.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Sentry — build-time source-map upload (SENTRY_AUTH_TOKEN is a secret; never
# NEXT_PUBLIC_, never baked into an image layer)
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_AUTH_TOKEN=<sentry-auth-token>

# PostHog — browser analytics + feature flags (token is a public ingest key)
# NEXT_PUBLIC_POSTHOG_ENABLED=true
# NEXT_PUBLIC_POSTHOG_TOKEN=phc_<project-token>
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
